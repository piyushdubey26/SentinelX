# Backend Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=piyushdubey
DB_PASSWORD=
DB_NAME=sentinelx
DB_LOGGING=false
DB_SSL=false

# JWT Authentication
JWT_SECRET=sentinelx-super-secure-dev-jwt-secret-replace-in-prod
